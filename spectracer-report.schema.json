{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "spectracer-report.schema.json",
    "title": "SpecTracerReport",
    "description": "Schema for a SpecTracer traceability report (the machine-readable twin of report.html).",
    "type": "object",
    "required": ["schemaVersion", "generatedAt", "config", "summary", "features"],
    "properties": {
        "schemaVersion": {
            "type": "string",
            "pattern": "^([0-9]+)(\\.(([1-9]\\d*)|0)){0,2}$",
            "description": "Version of this report format. Used for compatibility.",
            "examples": ["1", "1.0", "1.0.0"]
        },
        "generatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of when the report was generated."
        },
        "config": {
            "type": "object",
            "title": "ResolvedConfig",
            "description": "Verbatim echo of the resolved spectracer.config.json used to produce this report, for provenance when the JSON is archived independently of the repo state.",
            "required": ["features", "output"],
            "properties": {
                "features": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "unit": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": { "type": "string" }
                    }
                },
                "integration": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": { "type": "string" }
                    }
                },
                "e2e": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "array",
                        "items": { "type": "string" }
                    }
                },
                "output": { "type": "string" },
                "output_json": { "type": "string" },
                "render_mode": {
                    "type": "string",
                    "enum": ["server", "client"],
                    "description": "How the HTML report is rendered: 'server' (default, Jinja-rendered pages) or 'client' (embedded JSON rendered in the browser). UI-agnostic report data is identical either way."
                },
                "error_on_failure": { "type": "boolean" },
                "fail_on": {
                    "type": "array",
                    "description": "Health checks that gate CI. If any listed check reports a failing (red) status, the tool exits 1. Independent of and additive to error_on_failure.",
                    "items": {
                        "type": "string",
                        "enum": ["progress", "pyramid", "e2e_runtime", "unconfigured_modules"]
                    },
                    "uniqueItems": true
                },
                "health_checks": {
                    "type": "object",
                    "properties": {
                        "progress_threshold_green": { "type": "integer" },
                        "progress_threshold_amber": { "type": "integer" },
                        "e2e_duration_amber_seconds": { "type": "number" },
                        "e2e_duration_red_seconds": { "type": "number" }
                    }
                }
            }
        },
        "summary": {
            "type": "object",
            "title": "Summary",
            "required": ["completion", "pyramid", "health"],
            "properties": {
                "completion": {
                    "type": "object",
                    "title": "CompletionSummary",
                    "description": "Scenario-completion counts plus the declared-tests-matched percentage. `tested`/`total` are scenario counts (scenarios fully matched / total scenarios); `percent` is the declared-tests-matched percentage (satisfied/required), which is not `tested / total`.",
                    "required": ["tested", "total", "percent"],
                    "properties": {
                        "tested": { "type": "integer", "minimum": 0 },
                        "total": { "type": "integer", "minimum": 0 },
                        "percent": { "type": "number", "minimum": 0, "maximum": 100 }
                    }
                },
                "pyramid": {
                    "type": "object",
                    "title": "PyramidSummary",
                    "description": "Per-layer test counts, duration, and pass rate.",
                    "properties": {
                        "unit": { "$ref": "#/definitions/layerStats" },
                        "integration": { "$ref": "#/definitions/layerStats" },
                        "e2e": { "$ref": "#/definitions/layerStats" }
                    }
                },
                "layerStats": {
                    "type": "array",
                    "title": "LayerStatsDetail",
                    "description": "Full per-layer stats in presentation order (e2e, integration, unit). Used by the client renderer to draw the Test Pyramid tiers; carries the pass/fail/skip split and tier width that pyramid.summary omits.",
                    "items": { "$ref": "#/definitions/layerStatsDetail" }
                },
                "health": {
                    "type": "object",
                    "title": "HealthStatus",
                    "required": ["status", "reasons"],
                    "properties": {
                        "status": {
                            "type": "string",
                            "enum": ["green", "amber", "red"]
                        },
                        "reasons": {
                            "type": "array",
                            "description": "Human-readable explanations for the current status, e.g. 'inverted pyramid' or 'E2E duration exceeds red threshold'.",
                            "items": { "type": "string" }
                        }
                    }
                },
                "healthChecks": {
                    "type": "array",
                    "title": "HealthChecks",
                    "description": "The individual health-check cards in display order (Progress, pyramid, E2E runtime, unlinked, unconfigured modules). Used by the client renderer to draw the dashboard Health Check grid.",
                    "items": {
                        "type": "object",
                        "required": ["key", "status", "message", "value"],
                        "properties": {
                            "key": {
                                "type": "string",
                                "enum": ["Progress", "pyramid", "end_to_end_runtime", "unlinked", "unconfigured_modules"]
                            },
                            "status": {
                                "type": "string",
                                "enum": ["pass", "warn", "fail"]
                            },
                            "message": { "type": "string" },
                            "value": { "type": "string" },
                            "layers": {
                                "type": "array",
                                "description": "Present only on the pyramid check: per-layer counts for the mini chips.",
                                "items": {
                                    "type": "object",
                                    "required": ["name", "count"],
                                    "properties": {
                                        "name": { "$ref": "#/definitions/layer" },
                                        "count": { "type": "integer", "minimum": 0 }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "features": {
            "type": "array",
            "items": {
                "type": "object",
                "title": "FeatureResult",
                "required": ["name", "file", "scenarios"],
                "properties": {
                    "name": { "type": "string" },
                    "file": {
                        "type": "string",
                        "description": "Relative path to the .feature file."
                    },
                    "scenarios": {
                        "type": "array",
                        "items": { "$ref": "#/definitions/scenarioResult" }
                    }
                }
            }
        },
        "unlinkedTests": {
            "type": "array",
            "description": "Test results whose tags didn't match any scenario.",
            "items": {
                "type": "object",
                "required": ["layer", "testId", "name", "status", "tags"],
                "properties": {
                    "layer": { "$ref": "#/definitions/layer" },
                    "module": {
                        "type": "string",
                        "description": "Module key this result was registered under, if any (any layer)."
                    },
                    "testId": { "type": "string" },
                    "name": { "type": "string" },
                    "status": {
                        "type": "string",
                        "enum": ["passed", "failed", "skipped"]
                    },
                    "duration": {
                        "type": "number",
                        "description": "Duration in milliseconds, if reported by the underlying test result."
                    },
                    "tags": {
                        "type": "array",
                        "items": { "type": "string" }
                    }
                }
            }
        },
        "modules": {
            "type": "array",
            "title": "PerModuleSummary",
            "description": "Per-module summary cards for the #/modules tab. A module is a service-attributable unit/integration config key (e2e is fleet-only). Each entry carries the declared-tests-matched progress, the unit-vs-integration result counts, the unlinked count, and the worst result status as the health signal.",
            "items": {
                "type": "object",
                "required": ["key", "completion", "pyramid", "unlinked", "worst"],
                "properties": {
                    "key": { "type": "string" },
                    "completion": {
                        "type": "object",
                        "required": ["tested", "total", "pct"],
                        "properties": {
                            "tested": { "type": "integer", "minimum": 0 },
                            "total": { "type": "integer", "minimum": 0 },
                            "pct": { "type": "number", "minimum": 0, "maximum": 100 }
                        }
                    },
                    "pyramid": {
                        "type": "object",
                        "required": ["unit", "integration"],
                        "properties": {
                            "unit": {
                                "type": "object",
                                "required": ["count"],
                                "properties": {
                                    "count": { "type": "integer", "minimum": 0 }
                                }
                            },
                            "integration": {
                                "type": "object",
                                "required": ["count"],
                                "properties": {
                                    "count": { "type": "integer", "minimum": 0 }
                                }
                            }
                        }
                    },
                    "unlinked": { "type": "integer", "minimum": 0 },
                    "worst": {
                        "type": "string",
                        "enum": ["passed", "skipped", "failed", "none"]
                    }
                }
            }
        }
    },
    "definitions": {
        "layer": {
            "type": "string",
            "enum": ["unit", "integration", "e2e"]
        },
        "layerStats": {
            "type": "object",
            "title": "LayerStats",
            "properties": {
                "testCount": { "type": "integer", "minimum": 0 },
                "duration": {
                    "type": "number",
                    "description": "Total duration for this layer in milliseconds."
                },
                "passRate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                }
            }
        },
        "layerStatsDetail": {
            "type": "object",
            "title": "LayerStatsDetailEntry",
            "description": "Full per-layer stats used by the client renderer to draw a Test Pyramid tier.",
            "required": ["name", "count", "passed", "failed", "skipped", "duration", "passRate", "failRate", "skipRate", "widthPct"],
            "properties": {
                "name": { "$ref": "#/definitions/layer" },
                "count": { "type": "integer", "minimum": 0 },
                "passed": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "skipped": { "type": "integer", "minimum": 0 },
                "duration": { "type": "number", "minimum": 0 },
                "passRate": { "type": "number", "minimum": 0, "maximum": 100 },
                "failRate": { "type": "number", "minimum": 0, "maximum": 100 },
                "skipRate": { "type": "number", "minimum": 0, "maximum": 100 },
                "widthPct": {
                    "type": "number",
                    "description": "Tier bar width as a percentage of the largest layer's count, clamped to MIN_TIER_WIDTH_PCT."
                }
            }
        },
        "scenarioResult": {
            "type": "object",
            "title": "ScenarioResult",
            "required": ["name", "tags", "requirements", "results"],
            "properties": {
                "name": { "type": "string" },
                "steps": {
                    "type": "array",
                    "description": "The Gherkin steps of this scenario, in order. Used by the client renderer to expand the step list under the scenario row.",
                    "items": { "type": "string" }
                },
                "tags": {
                    "type": "array",
                    "description": "Linking tags on this scenario (e.g. @id:FC-42, @regression). Excludes @require-* tags.",
                    "items": { "type": "string" }
                },
                "requirements": {
                    "type": "array",
                    "description": "Declared @require-* layer requirements for this scenario and whether each is satisfied.",
                    "items": {
                        "type": "object",
                        "required": ["layer", "satisfied"],
                        "properties": {
                            "layer": { "$ref": "#/definitions/layer" },
                            "module": {
                                "type": "string",
                                "description": "Present only for module-scoped requirements, e.g. @require-unit:auth."
                            },
                            "satisfied": {
                                "type": "boolean",
                                "description": "False if this declared requirement ended up with zero linked results."
                            },
                            "unconfigured": {
                                "type": "boolean",
                                "description": "Present and true only when this module-scoped requirement names a module that isn't a registered config key at all (likely a typo), as distinct from a configured-but-empty module (#8)."
                            }
                        }
                    }
                },
                "results": {
                    "type": "array",
                    "description": "All test results linked to this scenario across all layers.",
                    "items": {
                        "type": "object",
                        "required": ["layer", "testId", "name", "status"],
                        "properties": {
                            "layer": { "$ref": "#/definitions/layer" },
                            "module": {
                                "type": "string",
                                "description": "Module key this result was registered under, if any (any layer)."
                            },
                            "testId": { "type": "string" },
                            "name": { "type": "string" },
                            "status": {
                                "type": "string",
                                "enum": ["passed", "failed", "skipped"]
                            },
                            "duration": {
                                "type": "number",
                                "description": "Duration in milliseconds, if reported by the underlying test result."
                            },
                            "failureMessage": {
                                "type": "string",
                                "description": "Full failure message/stack trace, present only when status is 'failed'."
                            }
                        }
                    }
                }
            }
        }
    }
}
